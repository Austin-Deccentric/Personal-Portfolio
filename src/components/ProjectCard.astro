---
import type { CollectionEntry } from 'astro:content';
import { statusInfo } from '../data/status';

interface Props {
  project: CollectionEntry<'projects'>;
  detailed?: boolean;
}

const { project, detailed = false } = Astro.props;
const { title, tagline, description, year, status, stack, category } = project.data;
const shownStack = stack.slice(0, 4);
---

<article class="card pcard" data-status={status}>
  <p class="pcard-meta">
    <span class="label muted">{category} · {year}</span>
    <span class={`pill pill--${status}`}>{statusInfo[status].label}</span>
  </p>
  <h3 class="pcard-title">
    <a href={`/projects/${project.id}`} class="pcard-link">{title}</a>
  </h3>
  <p class="pcard-tagline">{tagline}</p>
  {detailed && <p class="pcard-desc muted">{description}</p>}
  <ul class="tags" aria-label={`${title} stack`}>
    {shownStack.map((tech) => <li class="tag">{tech}</li>)}
    {stack.length > shownStack.length && <li class="tag">+{stack.length - shownStack.length}</li>}
  </ul>
  <p class="pcard-cta" aria-hidden="true">Read the case study →</p>
</article>

<style>
  .pcard {
    position: relative;
  }

  .pcard[hidden] {
    display: none;
  }

  .pcard:hover,
  .pcard:focus-within {
    border-color: var(--blue);
  }

  .pcard-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .pcard-title {
    font-size: 26px;
  }

  .pcard-link {
    text-decoration: none;
  }

  /* The title link covers the whole card, so the card is one tap target. */
  .pcard-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .pcard-link:focus-visible {
    outline: none;
  }

  .pcard:has(.pcard-link:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .pcard-tagline {
    font-weight: 500;
  }

  .pcard-desc {
    font-size: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pcard-cta {
    margin-top: auto;
    padding-top: 4px;
    font-weight: 600;
    color: var(--blue);
  }
</style>
