---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
  caption: string;
}

const { projects, caption } = Astro.props;

const statusGlyph = { shipped: '●', 'in-progress': '◐', coursework: '○' } as const;

// "Bello's Library Window" → "bellos-library-window", like a file name.
const slugify = (s: string) =>
  s.toLowerCase().replace(/['’]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<table class="ptable">
  <caption class="sr-only">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">name</th>
      <th scope="col">what</th>
      <th scope="col">stack</th>
      <th scope="col">status</th>
    </tr>
  </thead>
  <tbody>
    {
      projects.map((p, i) => (
        <tr>
          <td class="muted">{String(i + 1).padStart(2, '0')}</td>
          <td class="ptable-name">
            <a href={`/projects/${p.id}`}>{slugify(p.data.title)}</a>
          </td>
          <td>{p.data.tagline}</td>
          <td class="ptable-stack">{p.data.stack.slice(0, 2).join(' ').toLowerCase()}</td>
          <td class={`status status--${p.data.status}`}>
            {statusGlyph[p.data.status]} {p.data.status}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .ptable {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  th {
    text-align: left;
    font-weight: 400;
    color: var(--muted);
    padding: 8px 12px;
  }

  td {
    padding: 12px;
    border-top: 1px solid var(--border);
    vertical-align: top;
  }

  tbody tr:hover {
    background: var(--bar);
  }

  .ptable-name a {
    font-weight: 700;
    color: var(--text-strong);
  }

  .ptable-name a:hover {
    color: var(--green);
  }

  .ptable-stack {
    color: var(--cyan);
  }

  /* Phones: each row becomes a stacked card. */
  @media (max-width: 640px) {
    thead {
      display: none;
    }

    table,
    tbody {
      display: block;
    }

    tr {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 4px 12px;
      border: 1px solid var(--border);
      padding: 12px;
      margin-bottom: 12px;
    }

    td {
      display: block;
      padding: 0;
      border: 0;
    }

    td:nth-child(5) {
      grid-row: 1;
      grid-column: 2;
      justify-self: end;
    }

    td:nth-child(2),
    td:nth-child(3),
    td:nth-child(4) {
      grid-column: 1 / -1;
    }
  }
</style>
