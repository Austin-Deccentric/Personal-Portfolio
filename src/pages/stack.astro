---
import Base from '../layouts/Base.astro';
---

<Base title="Stack — Chukwu Austin">
  <section class="section">
    <div class="container">
      <p class="section-label">cat ./stack.txt</p>
      <h1 class="section-title">Stack</h1>
      <p class="section-intro">
        The tools and technologies I reach for when building backend systems.
      </p>

      <div class="stack-grid">
        <div class="card">
          <h3>backend</h3>
          <p class="stack-desc">APIs, data modeling, and business logic</p>
          <div class="stack-tags">
            <span class="tag">python 3.14</span>
            <span class="tag">fastapi</span>
            <span class="tag">sqlmodel</span>
            <span class="tag">sqlalchemy 2</span>
            <span class="tag">pydantic</span>
            <span class="tag">postgresql</span>
            <span class="tag">redis</span>
            <span class="tag">alembic</span>
            <span class="tag">slowapi</span>
            <span class="tag">apscheduler</span>
          </div>
        </div>

        <div class="card">
          <h3>infrastructure</h3>
          <p class="stack-desc">Deployment, containers, and tooling</p>
          <div class="stack-tags">
            <span class="tag">docker</span>
            <span class="tag">docker compose</span>
            <span class="tag">linux</span>
            <span class="tag">bash</span>
            <span class="tag">git</span>
            <span class="tag">render</span>
            <span class="tag">netlify</span>
            <span class="tag">uv</span>
          </div>
        </div>

        <div class="card">
          <h3>testing & quality</h3>
          <p class="stack-desc">Catching bugs before users do</p>
          <div class="stack-tags">
            <span class="tag">pytest</span>
            <span class="tag">ruff</span>
            <span class="tag">basedpyright</span>
          </div>
        </div>

        <div class="card">
          <h3>learning</h3>
          <p class="stack-desc">Where I'm growing next</p>
          <div class="stack-tags">
            <span class="tag">data pipelines</span>
            <span class="tag">cloud infra</span>
            <span class="tag">agentic ai</span>
            <span class="tag">llms</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-intro {
    max-width: 560px;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.75rem;
  }

  .stack-grid h3 {
    margin-bottom: 0.2rem;
    font-size: 0.85rem;
    text-transform: lowercase;
    color: var(--text-muted);
  }

  .stack-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
  }
</style>
