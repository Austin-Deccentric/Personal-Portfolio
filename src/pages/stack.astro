---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { stackGroups } from '../data/stack';
---

<Base title="Stack — Augustine Chukwu">
  <Masthead slot="masthead">
    <p class="label">Stack</p>
    <h1>The tools I build with</h1>
    <p class="lede">
      What I reach for when building backend and AI systems, and the frontends that sit on top of
      them.
    </p>
  </Masthead>

  <div class="cards container">
    {
      stackGroups.map((group) => (
        <section class="card">
          <h2 class="group-title">{group.name}</h2>
          <p class="muted">{group.desc}</p>
          <ul class="tags" aria-label={`${group.name} stack`}>
            {group.items.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .group-title {
    font-size: 24px;
  }
</style>
