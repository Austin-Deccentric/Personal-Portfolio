---
import Base from '../layouts/Base.astro';
import Pane from '../components/Pane.astro';
import { stackGroups } from '../data/stack';
---

<Base title="Stack — Chukwu Austin">
  <Pane as="header" variant="active">
    <p class="muted small">
      <span class="prompt-user">austin@deccentric</span><span class="prompt-path">:~/portfolio$</span> cat ./stack.txt
    </p>
    <h1 class="page-title">Stack</h1>
    <p class="secondary">
      The tools I reach for when building backend systems and the frontends that sit on top of them.
    </p>
  </Pane>

  <div class="stack-grid">
    {
      stackGroups.map((group) => (
        <Pane title={group.name}>
          <p class="muted small">{group.desc}</p>
          <ul class="tags" aria-label={`${group.name} stack`}>
            {group.items.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </Pane>
      ))
    }
  </div>
</Base>

<style>
  .page-title {
    font-size: clamp(28px, 5vw, 40px);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--gap);
  }
</style>
