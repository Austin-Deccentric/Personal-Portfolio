---
import Base from '../layouts/Base.astro';

const channels = [
  {
    name: 'Email',
    value: 'chukwuaugust0@gmail.com',
    href: 'mailto:chukwuaugust0@gmail.com',
    note: 'Best for job opportunities, KekeVest conversations and detailed messages.',
  },
  {
    name: 'LinkedIn',
    value: 'linkedin.com/in/augustine-chukwu-',
    href: 'https://www.linkedin.com/in/augustine-chukwu-/',
    note: 'Professional profile, experience and recommendations.',
  },
  {
    name: 'GitHub',
    value: 'github.com/Austin-Deccentric',
    href: 'https://github.com/Austin-Deccentric',
    note: 'Code, case-study repos and open source work.',
  },
];
---

<Base title="Contact — Augustine Chukwu">
  <header class="page-head container">
    <p class="label">Contact</p>
    <h1>Let's talk</h1>
    <p class="lede">
      I'm open to remote backend and AI engineering roles, and to conversations about KekeVest.
      Whether you have an opportunity, a question, or just want to say hi, my inbox is open.
    </p>
    <div class="actions">
      <a href="mailto:chukwuaugust0@gmail.com" class="btn btn-primary">Email me</a>
    </div>
  </header>

  <div class="cards container">
    {
      channels.map((c) => (
        <section class="card">
          <h2 class="channel-title">{c.name}</h2>
          <a
            href={c.href}
            class="hit channel-value"
            rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {c.value}
          </a>
          <p class="muted">{c.note}</p>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .channel-title {
    font-size: 24px;
  }

  .channel-value {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
