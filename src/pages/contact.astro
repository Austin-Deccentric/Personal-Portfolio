---
import Base from '../layouts/Base.astro';
import Pane from '../components/Pane.astro';

const channels = [
  {
    cmd: '$ mail',
    name: 'email',
    value: 'chukwuaugust0@gmail.com',
    href: 'mailto:chukwuaugust0@gmail.com',
    note: 'best for detailed messages and job opportunities',
  },
  {
    cmd: '$ git remote -v',
    name: 'github',
    value: 'github.com/Austin-Deccentric',
    href: 'https://github.com/Austin-Deccentric',
    note: 'code, contributions and open source work',
  },
  {
    cmd: '$ cat ./resume',
    name: 'linkedin',
    value: 'linkedin.com/in/augustine-chukwu',
    href: 'https://www.linkedin.com/in/augustine-chukwu',
    note: 'professional profile and resume',
  },
];
---

<Base title="Contact — Chukwu Austin">
  <Pane as="header" variant="active">
    <p class="muted small">
      <span class="prompt-user">austin@deccentric</span><span class="prompt-path">:~/portfolio$</span> ./contact.sh
    </p>
    <h1 class="page-title">Contact</h1>
    <p class="secondary">
      I'm open to full-stack and backend engineering roles. Whether you have an opportunity, a
      question, or just want to say hi — my inbox is open.
    </p>
  </Pane>

  <div class="contact-grid">
    {
      channels.map((c) => (
        <Pane title={c.name.toUpperCase()}>
          <p class="prompt-user small">{c.cmd}</p>
          <a
            href={c.href}
            class="contact-value"
            rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {c.value}
          </a>
          <p class="muted small">{c.note}</p>
        </Pane>
      ))
    }
  </div>
</Base>

<style>
  .page-title {
    font-size: clamp(28px, 5vw, 40px);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--gap);
  }

  .contact-value {
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
  }
</style>
