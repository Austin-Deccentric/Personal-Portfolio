---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Section from '../../components/Section.astro';
import { getCollection } from 'astro:content';
import { statusInfo } from '../../data/status';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next: nextProject } = Astro.props;
const {
  title,
  tagline,
  description,
  role,
  year,
  category,
  status,
  repo,
  live,
  docs,
  stack,
  highlights,
  problem,
  constraints,
  architecture,
  decisions,
  next,
  pipeline,
  pipelineNote,
} = project.data;

---

<Base title={`${title} — Augustine Chukwu`} description={description}>
  <Masthead slot="masthead">
    <nav aria-label="Breadcrumb" class="crumbs small">
      <a class="hit" href="/">Home</a><span aria-hidden="true">/</span><a class="hit" href="/projects">Projects</a><span
        aria-hidden="true">/</span
      ><span aria-current="page">{title}</span>
    </nav>

    <div class="case-head">
      <p class="case-meta">
        <span class="label">Case study · {category} · {year}</span>
        <span class={`pill pill--${status}`}>{statusInfo[status].label}</span>
      </p>
      <h1>{title}</h1>
      <p class="case-tagline">{tagline}</p>
      <p class="case-desc">{description}</p>
      <div class="actions">
        {live && <a href={live} class="btn btn-primary" rel="noopener noreferrer">Open the live site ↗</a>}
        {docs && <a href={docs} class="btn" rel="noopener noreferrer">Read API docs</a>}
        {repo && <a href={repo} class="btn" rel="noopener noreferrer">View source</a>}
      </div>
      <p class="role"><span class="label">Role</span> {role}</p>
    </div>
  </Masthead>

  {
    pipeline.length > 0 && (
      <Section title="How it works" class="container">
        <ol class="pipeline">
          {pipeline.map((stage, i) => (
            <li class={`stage stage--${stage.kind}`}>
              {i > 0 && <span class="arrow" aria-hidden="true">→</span>}
              <span class="stage-box">{stage.label}</span>
            </li>
          ))}
        </ol>
        {pipelineNote && <p class="muted small">{pipelineNote}</p>}
      </Section>
    )
  }

  {
    problem && (
      <section class="band" aria-labelledby="problem-title">
        <div class="problem container">
          <p class="label">The problem</p>
          <h2 id="problem-title" class="sr-only">Problem</h2>
          <p class="problem-text">{problem}</p>
        </div>
      </section>
    )
  }

  {
    (highlights.length > 0 || decisions.length > 0) && (
      <div class="row container">
        {highlights.length > 0 && (
          <Section title="Highlights" class="half card">
            <ul class="bullets">
              {highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </Section>
        )}
        {decisions.length > 0 && (
          <Section title="Decisions" class="half card">
            <ul class="bullets bullets--decisions">
              {decisions.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </Section>
        )}
      </div>
    )
  }

  {
    (constraints.length > 0 || architecture.length > 0) && (
      <div class="row container">
        {constraints.length > 0 && (
          <Section title="Constraints" class="half card">
            <ul class="bullets">
              {constraints.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </Section>
        )}
        {architecture.length > 0 && (
          <Section title="Architecture" class="half card">
            <ul class="bullets">
              {architecture.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </Section>
        )}
      </div>
    )
  }

  {
    next.length > 0 && (
      <Section title="Next steps" class="container">
        <ul class="bullets bullets--todo">
          {next.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section title="Stack" class="container">
    <ul class="tags" aria-label={`${title} stack`}>
      {stack.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
  </Section>

  {
    nextProject.id !== project.id && (
      <p class="next container">
        <span class="label muted">Next project</span>
        <a class="hit" href={`/projects/${nextProject.id}`}>{nextProject.data.title} →</a>
      </p>
    )
  }
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .crumbs [aria-current] {
    color: var(--text);
  }

  .case-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .case-tagline {
    font-size: 22px;
    font-weight: 600;
    max-width: 50ch;
    color: var(--text);
  }

  .case-desc {
    font-size: 18px;
    max-width: 64ch;
    color: var(--text);
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }

  .pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 15px;
  }

  .stage {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .arrow {
    color: var(--muted);
  }

  .stage-box {
    display: inline-block;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    padding: 10px 16px;
  }

  .stage--step .stage-box {
    border: 1.5px solid var(--blue);
    color: var(--blue);
    font-weight: 500;
  }

  .stage--gate .stage-box {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--text);
    font-weight: 600;
  }

  /* One centred reading column on the blue band. */
  .problem {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 56px;
    padding-bottom: 56px;
  }

  .problem-text {
    font-family: var(--serif);
    font-size: clamp(20px, 2.6vw, 24px);
    line-height: 1.5;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    font-weight: 600;
  }
</style>
