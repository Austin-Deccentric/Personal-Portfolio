---
import Base from '../../layouts/Base.astro';
import Pane from '../../components/Pane.astro';
import { getCollection } from 'astro:content';
import { statusInfo } from '../../data/status';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next: nextProject } = Astro.props;
const {
  title,
  tagline,
  description,
  role,
  year,
  status,
  repo,
  live,
  docs,
  stack,
  highlights,
  problem,
  constraints,
  architecture,
  decisions,
  next,
  pipeline,
  pipelineNote,
} = project.data;

const status_ = statusInfo[status];
---

<Base title={`${title} — Chukwu Austin`} description={description}>
  <nav aria-label="Breadcrumb" class="crumbs small muted">
    <a class="hit" href="/">~/portfolio</a><span aria-hidden="true">/</span><a class="hit" href="/projects">projects</a><span
      aria-hidden="true">/</span
    ><span aria-current="page">{project.id}</span>
  </nav>

  <Pane as="header" variant="active" loose>
    <p class="small prompt-user">
      ┌─ Case study ── {year} ── <span class={`status status--${status}`}>{status_.glyph} {status_.label}</span>
    </p>
    <h1 class="case-title">{title}</h1>
    <p class="case-tagline">{tagline}</p>
    <p class="secondary">{description}</p>
    <div class="actions">
      {live && <a href={live} class="btn btn-primary" rel="noopener noreferrer">↗ Open live site</a>}
      {docs && <a href={docs} class="btn" rel="noopener noreferrer">Read API docs</a>}
      {repo && <a href={repo} class="btn" rel="noopener noreferrer">View source</a>}
      <span class="btn role" aria-label={`Role: ${role}`}>Role: {role}</span>
    </div>
  </Pane>

  {
    pipeline.length > 0 && (
      <Pane title="Pipeline">
        <ol class="pipeline">
          {pipeline.map((stage, i) => (
            <li class={`stage stage--${stage.kind}`}>
              {i > 0 && <span class="arrow muted" aria-hidden="true">──▶</span>}
              <span class="stage-box">{stage.label}</span>
            </li>
          ))}
        </ol>
        {pipelineNote && <p class="muted small">{pipelineNote}</p>}
      </Pane>
    )
  }

  {
    problem && (
      <Pane title="Problem">
        <p>{problem}</p>
      </Pane>
    )
  }

  {
    (highlights.length > 0 || decisions.length > 0) && (
      <div class="row">
        {highlights.length > 0 && (
          <Pane title="Highlights" class="half">
            <ul class="bullets">
              {highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </Pane>
        )}
        {decisions.length > 0 && (
          <Pane title="Decisions" class="half">
            <ul class="bullets bullets--decisions">
              {decisions.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </Pane>
        )}
      </div>
    )
  }

  {
    (constraints.length > 0 || architecture.length > 0) && (
      <div class="row">
        {constraints.length > 0 && (
          <Pane title="Constraints" class="half">
            <ul class="bullets">
              {constraints.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </Pane>
        )}
        {architecture.length > 0 && (
          <Pane title="Architecture" class="half">
            <ul class="bullets">
              {architecture.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </Pane>
        )}
      </div>
    )
  }

  {
    next.length > 0 && (
      <Pane title="Next steps">
        <ul class="bullets bullets--todo">
          {next.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
      </Pane>
    )
  }

  <Pane title="Stack">
    <ul class="tags" aria-label={`${title} stack`}>
      {stack.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
  </Pane>

  {
    nextProject.id !== project.id && (
      <p class="small">
        <span class="muted">Next project:</span>
        <a class="hit" href={`/projects/${nextProject.id}`}>{nextProject.data.title} →</a>
      </p>
    )
  }
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .crumbs [aria-current] {
    color: var(--text-strong);
  }

  .case-title {
    font-size: clamp(32px, 7vw, 48px);
  }

  .case-tagline {
    font-size: 20px;
  }

  .actions {
    margin-top: 8px;
  }

  .role {
    color: var(--muted);
    cursor: default;
  }

  .role:hover {
    color: var(--muted);
    border-color: var(--border);
  }

  .pipeline {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 14px;
  }

  .stage {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .stage-box {
    border: 1px solid var(--border);
    padding: 12px 16px;
  }

  .stage--step .stage-box {
    border-color: var(--green);
    color: var(--green);
  }

  .stage--gate .stage-box {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--on-accent);
    font-weight: 600;
  }
</style>
