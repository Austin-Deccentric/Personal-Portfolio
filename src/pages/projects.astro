---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { statusInfo } from '../data/status';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// One filter per status that has projects, in the order statusInfo lists them.
const filters = (Object.keys(statusInfo) as (keyof typeof statusInfo)[])
  .map((key) => ({ key, label: statusInfo[key].label, count: projects.filter((p) => p.data.status === key).length }))
  .filter((f) => f.count > 0);
---

<Base title="Projects — Augustine Chukwu">
  <header class="page-head container">
    <p class="label">Work</p>
    <h1>All projects</h1>
    <p class="lede">
      Backend and AI systems I've built, from a voice-note inbox and a hotel booking API to
      smaller coursework projects. Each one has a case study on how it was built.
    </p>
  </header>

  <Section class="container">
    <h2 class="sr-only">Project list</h2>
    <div class="filters" role="group" aria-label="Filter projects by status" data-filters hidden>
      <button type="button" class="btn filter" aria-pressed="true" data-filter="all">
        All <span class="count">{projects.length}</span>
      </button>
      {
        filters.map((f) => (
          <button type="button" class="btn filter" aria-pressed="false" data-filter={f.key}>
            {f.label} <span class="count">{f.count}</span>
          </button>
        ))
      }
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
    <div class="cards cards--2">
      {projects.map((project) => <ProjectCard project={project} detailed />)}
    </div>
  </Section>
</Base>

<script is:inline>
  (function () {
    var group = document.querySelector('[data-filters]');
    var status = document.querySelector('[data-filter-status]');
    var cards = Array.prototype.slice.call(document.querySelectorAll('.pcard'));
    var buttons = Array.prototype.slice.call(group.querySelectorAll('[data-filter]'));
    group.hidden = false;

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var key = btn.getAttribute('data-filter');
        var shown = 0;
        cards.forEach(function (card) {
          var match = key === 'all' || card.getAttribute('data-status') === key;
          card.hidden = !match;
          if (match) shown++;
        });
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', String(b === btn));
        });
        status.textContent = 'Showing ' + shown + ' project' + (shown === 1 ? '' : 's');
      });
    });
  })();
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filters[hidden] {
    display: none;
  }

  .filter {
    min-height: 44px;
    padding: 0 16px;
    border-color: var(--border);
    background: var(--surface);
  }

  .filter:hover {
    border-color: var(--blue);
    background: var(--surface);
    color: var(--blue);
  }

  .filter[aria-pressed='true'] {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--on-blue);
  }

  .count {
    font-weight: 500;
    opacity: 0.75;
  }
</style>
