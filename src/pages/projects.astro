---
import Base from '../layouts/Base.astro';
import Pane from '../components/Pane.astro';
import ProjectTable from '../components/ProjectTable.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const featured = projects.filter((p) => p.data.featured);
const other = projects.filter((p) => !p.data.featured);
---

<Base title="Projects — Chukwu Austin">
  <Pane as="header" variant="active">
    <p class="muted small">
      <span class="prompt-user">austin@deccentric</span><span class="prompt-path">:~/portfolio$</span> ls -la ./projects
    </p>
    <h1 class="page-title">All projects</h1>
    <p class="secondary">
      Full-stack apps, APIs and tools I've built — from a voice-note inbox and a hotel booking
      system to smaller coursework projects.
    </p>
  </Pane>

  <Pane title={`FEATURED ── ${featured.length}`}>
    <ProjectTable projects={featured} caption="Featured projects" />
  </Pane>

  <Pane title={`ALSO BUILT ── ${other.length}`}>
    <ProjectTable projects={other} caption="Other projects" />
  </Pane>
</Base>

<style>
  .page-title {
    font-size: clamp(28px, 5vw, 40px);
  }
</style>
