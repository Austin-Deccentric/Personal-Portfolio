---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Section from '../components/Section.astro';
import { getCollection } from 'astro:content';
import { statusInfo } from '../data/status';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// The route: featured projects as stops, with KekeVest as the second stop.
const projectStops = featured.map((p) => ({
  meta: `${p.data.category} · ${statusInfo[p.data.status].label}`,
  title: p.data.title,
  line: p.data.pitch ?? p.data.tagline,
  href: `/projects/${p.id}`,
  lit: p.data.status === 'shipped',
}));
const stops = [
  ...projectStops.slice(0, 1),
  {
    meta: 'Startup · Live',
    title: 'KekeVest',
    line: 'Riders pay weekly and end up owning their keke. Owners see every payment. Nobody loses a tricycle over a missing record.',
    href: '#kekevest',
    lit: true,
  },
  ...projectStops.slice(1),
].map((stop, i) => ({ ...stop, no: String(i + 1).padStart(2, '0') }));

// The hero photo shows once public/photo.jpg exists; without it the hero is text only.
const hasPhoto = existsSync(join(process.cwd(), 'public', 'photo.jpg'));
---

<Base title="Augustine (Austin) Chukwu — AI and backend engineer">
  <Masthead slot="masthead" class:list={['hero', { 'hero--photo': hasPhoto }]}>
    {
      hasPhoto && (
        <Fragment slot="art">
          <div class="hero-photo">
            <img src="/photo.jpg" width="900" height="1125" alt="Augustine Chukwu" fetchpriority="high" />
          </div>
          <span class="sticker hero-sticker">Co-founder · KekeVest</span>
        </Fragment>
      )
    }
    <h1>Software that goes where <span class="accent">people</span> actually go.</h1>
    <p class="lede">
      I'm Augustine (Austin). I build backend and AI systems for the shops, riders and small
      businesses big tech drives past.
    </p>
    <div class="actions">
      <a href="#work" class="btn btn-primary">See the route</a>
      <a href="/contact" class="btn btn-link">Get in touch</a>
    </div>
  </Masthead>

  <Section id="work" class="container">
    <div class="section-head">
      <h2>The route so far</h2>
      <span class="label muted">{stops.length} stops · more coming</span>
    </div>
    <ol class="route">
      {
        stops.map((stop) => (
          <li class="stop">
            <span class="stop-rail" aria-hidden="true">
              <span class:list={['stop-dot', { 'stop-dot--lit': stop.lit }]} />
            </span>
            <a class="stop-body" href={stop.href}>
              <span class="label muted">Stop {stop.no} · {stop.meta}</span>
              <span class="stop-title">{stop.title} →</span>
              <span class="stop-line">{stop.line}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <p><a href="/projects" class="btn">See all projects</a></p>
  </Section>

  <section class="band" aria-labelledby="why-title">
    <div class="why container">
      <div class="why-head">
        <p class="label">Why I build</p>
        <h2 id="why-title">Software should work for the <span class="accent">people</span> in front of you.</h2>
      </div>
      <div class="prose why-body">
        <p>
          A shop owner gets voice notes all day, in Pidgin, Igbo and English, and answers every one
          by hand. A keke rider pays every week for months, then loses the tricycle over two missed
          payments, because nobody kept a record.
        </p>
        <p>
          Most software isn't built with them in mind. I build for exactly these people: tools that
          understand how they talk, keep honest records, and still work when the network doesn't.
        </p>
      </div>
    </div>
  </section>

  <Section class="container">
    <h2>What brings you here?</h2>
    <div class="cards cards--2">
      <div class="card">
        <h3>Hiring an engineer</h3>
        <p>Tested Python and FastAPI systems, with case studies showing how each one was built.</p>
        <a href="/projects" class="hit card-link">See case studies →</a>
      </div>
      <div class="card">
        <h3>Investing in KekeVest</h3>
        <p>A fairer path to tricycle ownership, with every payment recorded.</p>
        <a href="#kekevest" class="hit card-link">Read the KekeVest story →</a>
      </div>
    </div>
  </Section>

  <Section id="kekevest" class="container">
    <div class="kv">
      <div class="kv-head">
        <p class="label">Currently building</p>
        <h2>KekeVest</h2>
        <span class="sticker kv-sticker">Co-founder &amp; team lead</span>
      </div>
      <p class="kv-lede">
        A managed keke (tricycle) fleet and rider-ownership platform. Riders lease a keke and pay
        their way to owning it; asset owners watch their vehicles and collections on a ledger nobody
        can quietly edit.
      </p>
      <p class="muted kv-part">
        My part: the core domain tables, rider sign-up and office appointments, offers, contracts
        and repayment schedules, the double-entry ledger, and the rider portal.
      </p>
      <ul class="tags" aria-label="KekeVest stack">
        <li class="tag">FastAPI</li>
        <li class="tag">SQLModel</li>
        <li class="tag">PostgreSQL + PostGIS</li>
        <li class="tag">Next.js</li>
        <li class="tag">TypeScript</li>
        <li class="tag">Paystack</li>
      </ul>
      <div class="actions">
        <a href="https://www.kekevest.com/" class="btn btn-primary" rel="noopener noreferrer">Visit kekevest.com ↗</a>
      </div>
    </div>
  </Section>

  <Section id="about" class="container">
    <h2>About</h2>
    <div class="prose">
      <p>
        I like building things end to end — the API, the database behind it, and the screen
        someone actually taps. Before software, I spent five years turning data into decisions,
        which is why I care so much about honest records and systems that don't break.
      </p>
      <p>
        Most of what I know came from breaking something and refusing to leave it broken, usually
        later at night than I'd admit. Lately that's been
        <a href="/projects/voicedesk">VoiceDesk</a>. A lot of people here send voice notes instead
        of typing, so I built an inbox that listens, translates and drafts a reply, then waits for a
        real person to say yes before anything goes out.
      </p>
      <p>Friends call me Austin. When I'm not at the keyboard, I'm usually at the gym.</p>
    </div>
  </Section>
</Base>

<style>
  /* The masthead root and its slots render inside the Masthead component. */
  :global(.hero h1) {
    max-width: 860px;
  }

  :global(.hero--photo .masthead-inner) {
    padding-bottom: 96px;
  }

  /* Photo on the right, fading left into the gold behind the headline.
     Black and white, multiplied onto the gold so it takes the page's colour. */
  .hero-photo {
    position: absolute;
    right: 0;
    top: calc(-1 * var(--header-h));
    bottom: var(--road-h);
    width: min(620px, 50%);
    background: var(--gold);
    overflow: hidden;
    /* Fades in from the left and from under the header, so nav links stay on clean gold. */
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.35) 22%, rgba(0, 0, 0, 0.85) 48%, #000 70%),
      linear-gradient(to bottom, transparent 0, transparent calc(var(--header-h) - 16px), #000 calc(var(--header-h) + 96px));
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.35) 22%, rgba(0, 0, 0, 0.85) 48%, #000 70%),
      linear-gradient(to bottom, transparent 0, transparent calc(var(--header-h) - 16px), #000 calc(var(--header-h) + 96px));
    mask-composite: intersect;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    filter: grayscale(1) contrast(1.15) brightness(1.05);
    mix-blend-mode: multiply;
  }

  .hero-sticker {
    position: absolute;
    z-index: 1;
    right: 96px;
    top: 24px;
  }

  .route {
    display: flex;
    flex-direction: column;
  }

  .stop {
    display: flex;
    gap: 28px;
  }

  .stop-rail {
    flex-shrink: 0;
    width: 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Dashed road between stops; the last stop has none. */
  .stop-rail::after {
    content: "";
    flex-grow: 1;
    border-left: 4px dashed var(--blue);
  }

  .stop:last-child .stop-rail::after {
    border-color: transparent;
  }

  .stop-dot {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 4px solid var(--blue);
    background: var(--bg);
  }

  .stop-dot--lit {
    background: var(--gold);
  }

  .stop-body {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 4px 0 40px;
    text-decoration: none;
    color: var(--text);
  }

  .stop-title {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--blue);
  }

  .stop-body:hover .stop-title {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }

  .stop-line {
    font-size: 18px;
    max-width: 62ch;
  }

  .why {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 56px;
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .why-head {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .why-body {
    flex: 999 1 460px;
    min-width: 0;
    font-size: 18px;
    color: #e4e9f0;
  }

  .card-link {
    margin-top: auto;
    font-weight: 700;
  }

  .kv {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 40px;
    border-radius: 24px;
    background: var(--gold);
  }

  .kv-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .kv-sticker {
    position: absolute;
    right: 40px;
    top: 40px;
  }

  .kv-lede {
    font-size: 20px;
    font-weight: 500;
    max-width: 60ch;
  }

  .kv-part {
    max-width: 68ch;
    color: var(--text);
  }

  .kv .tag {
    background: rgba(250, 246, 239, 0.7);
    border-color: rgba(18, 53, 91, 0.25);
    color: var(--text);
  }

  @media (max-width: 767.98px) {
    /* On phones the photo sits on top and fades down into the headline. */
    :global(.hero--photo .masthead-inner) {
      padding-top: 290px;
      padding-bottom: 48px;
    }

    /* The fade ends before the headline starts, so the text sits on plain gold. */
    .hero-photo {
      top: 0;
      bottom: auto;
      width: 100%;
      height: 380px;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 64px, #000 30%, transparent 76%);
      mask-image: linear-gradient(to bottom, transparent 0, #000 64px, #000 30%, transparent 76%);
    }

    .hero-sticker {
      right: 16px;
      top: 16px;
      font-size: 12px;
      padding: 8px 12px;
    }

    .stop {
      gap: 16px;
    }

    .stop-rail {
      width: 32px;
    }

    .stop-dot {
      width: 28px;
      height: 28px;
      border-width: 3px;
    }

    .kv {
      padding: 24px;
    }

    .kv-sticker {
      position: static;
      align-self: flex-start;
      transform: rotate(-3deg);
      font-size: 12px;
      padding: 8px 12px;
    }
  }
</style>
