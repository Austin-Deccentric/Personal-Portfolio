---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// The hero photo shows once public/photo.jpg is added; until then the hero is text only.
const hasPhoto = existsSync(new URL('../../public/photo.jpg', import.meta.url));
---

<Base title="Augustine (Austin) Chukwu — AI and backend engineer">
  <section class:list={['hero container', { 'hero--photo': hasPhoto }]}>
    <div class="hero-main">
      <p class="label">AI + backend engineer · Nigeria</p>
      <h1>I build software for the businesses <span class="mark">big tech overlooks.</span></h1>
      <p class="lede">
        I'm Augustine, and friends call me Austin. I build backend and AI systems for African
        businesses, from a voice-note inbox that understands Pidgin to a platform that helps keke
        riders own their tricycle.
      </p>
      <div class="actions">
        <a href="#work" class="btn btn-primary">See my work</a>
        <a href="/contact" class="btn btn-link">Get in touch</a>
      </div>
    </div>
    {
      hasPhoto && (
        <img
          class="hero-photo"
          src="/photo.jpg"
          width="800"
          height="1000"
          alt="Augustine Chukwu"
          fetchpriority="high"
        />
      )
    }
  </section>

  <section class="band" aria-labelledby="why-title">
    <div class="why container">
      <div class="why-head">
        <p class="label">Why I build</p>
        <h2 id="why-title">Software should work for the people in front of you.</h2>
      </div>
      <div class="prose why-body">
        <p>
          A shop owner gets voice notes all day, in Pidgin, Igbo and English, and answers every one
          by hand. A keke rider pays every week for months, then loses the tricycle over two missed
          payments, because nobody kept a record.
        </p>
        <p>
          Most software isn't built with them in mind. I build for exactly these people: tools that
          understand how they talk, keep honest records, and still work when the network doesn't.
        </p>
      </div>
    </div>
  </section>

  <Section title="What brings you here?" class="container">
    <div class="cards cards--2">
      <div class="card">
        <h3>Hiring an engineer</h3>
        <p>Tested Python and FastAPI systems, with case studies showing how each one was built.</p>
        <a href="/projects" class="hit card-link">See case studies →</a>
      </div>
      <div class="card">
        <h3>Investing in KekeVest</h3>
        <p>A fairer path to tricycle ownership, with every payment recorded.</p>
        <a href="#kekevest" class="hit card-link">Read the KekeVest story →</a>
      </div>
    </div>
  </Section>

  <Section id="kekevest" eyebrow="Currently building" title="KekeVest" class="container">
    <div class="card kv">
      <div class="kv-head">
        <span class="label muted">Co-founder and team lead</span>
        <span class="pill pill--in-progress">Building</span>
      </div>
      <p class="kv-lede">
        A managed keke (tricycle) fleet and rider-ownership platform. Riders lease a keke and pay
        their way to owning it; asset owners watch their vehicles and collections on a ledger nobody
        can quietly edit.
      </p>
      <p class="muted">
        My part: the core domain tables, rider sign-up and office appointments, offers, contracts
        and repayment schedules, the double-entry ledger, and the rider portal.
      </p>
      <ul class="tags" aria-label="KekeVest stack">
        <li class="tag">FastAPI</li>
        <li class="tag">SQLModel</li>
        <li class="tag">PostgreSQL + PostGIS</li>
        <li class="tag">Next.js</li>
        <li class="tag">TypeScript</li>
        <li class="tag">Paystack</li>
      </ul>
      <div class="actions">
        <a href="https://www.kekevest.com/" class="btn" rel="noopener noreferrer">Visit kekevest.com ↗</a>
      </div>
    </div>
  </Section>

  <Section id="work" title="Selected work" class="container">
    <div class="cards cards--2">
      {featured.map((project) => <ProjectCard project={project} detailed />)}
    </div>
    <p><a href="/projects" class="hit">See all projects →</a></p>
  </Section>

  <Section id="about" title="About" class="container">
    <div class="prose">
      <p>
        I like building things end to end — the API, the database behind it, and the screen
        someone actually taps. Before software, I spent five years turning data into decisions,
        which is why I care so much about honest records and systems that don't break.
      </p>
      <p>
        Most of what I know came from breaking something and refusing to leave it broken, usually
        later at night than I'd admit. Lately that's been
        <a href="/projects/voicedesk">VoiceDesk</a>. A lot of people here send voice notes instead
        of typing, so I built an inbox that listens, translates and drafts a reply, then waits for a
        real person to say yes before anything goes out.
      </p>
      <p>Friends call me Austin. When I'm not at the keyboard, I'm usually at the gym.</p>
    </div>
  </Section>
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    padding-top: 32px;
  }

  .hero-main {
    flex: 999 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero:not(.hero--photo) .hero-main {
    max-width: 820px;
  }

  .hero-photo {
    flex: 1 1 300px;
    max-width: 400px;
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: cover;
    border-radius: 20px;
    background: var(--blue);
  }

  .why {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .why-head {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .why-body {
    flex: 999 1 460px;
    min-width: 0;
    font-size: 18px;
  }

  .card-link {
    margin-top: auto;
    font-weight: 600;
  }

  .kv-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .kv-lede {
    font-size: 18px;
    max-width: 68ch;
  }

  .kv .muted {
    max-width: 68ch;
  }

  .kv .actions {
    margin-top: 8px;
  }
</style>
