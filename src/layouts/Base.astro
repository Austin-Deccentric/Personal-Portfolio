---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

import '../styles/global.css';

const {
  title,
  description = 'Full-stack engineer building production-shaped APIs with FastAPI and PostgreSQL, and the Next.js + TypeScript frontends on top of them.',
  ogImage,
} = Astro.props;

// Crawlers ignore relative og:image URLs, so resolve against the site.
// NOTE: `site` in astro.config.mjs must be the real deployed domain
// for link previews to render.
const ogImageUrl = ogImage ?? (Astro.site ? new URL('og-image.png', Astro.site).href : undefined);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tabs = [
  { key: '1', label: 'Home', short: 'Home', href: '/', active: path === '/' },
  { key: '2', label: 'Projects', short: 'Work', href: '/projects', active: path.startsWith('/projects') },
  { key: '3', label: 'Stack', short: 'Stack', href: '/stack', active: path === '/stack' },
  { key: '4', label: 'Contact', short: 'Contact', href: '/contact', active: path === '/contact' },
];

const displayPath = path === '/' ? '~/portfolio' : `~/portfolio${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chukwu Austin — Full-Stack Engineer" />
    {Astro.url && <meta property="og:url" content={Astro.url.href} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        var theme = stored || (prefersLight ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
      <nav class="tabs" aria-label="Primary">
        {
          tabs.map((tab) => (
            <a
              class="tab-link"
              href={tab.href}
              aria-current={tab.active ? 'page' : undefined}
              aria-keyshortcuts={tab.key}
            >
              <span class="key" aria-hidden="true">{tab.key}</span>
              {tab.label}
            </a>
          ))
        }
        <span class="tabs-end-group">
          <button id="keys-toggle" type="button" aria-pressed="true">
            <span id="keys-label">Turn off</span> shortcuts
          </button>
          <button id="theme-toggle" type="button" aria-keyshortcuts="t">
            <span class="key" aria-hidden="true">t</span> Switch to <span id="theme-label">light</span>
          </button>
        </span>
      </nav>

      <main id="main" class="stack-v" style="gap: var(--gap)">
        <slot />
      </main>

      <footer class="statusbar">
        <span>
          <span class="mode">NORMAL</span>
          <span class="cell">{displayPath}</span>
        </span>
        <span>
          <span class="cell hide-sm muted">Open to full-stack and backend roles</span>
          <span class="cell">
            <a href="https://github.com/Austin-Deccentric" rel="noopener noreferrer">GitHub</a>
            · <a href="https://www.linkedin.com/in/augustine-chukwu" rel="noopener noreferrer">LinkedIn</a>
            · <a href="mailto:chukwuaugust0@gmail.com">Email</a>
          </span>
        </span>
      </footer>
    </div>

    <nav class="bottom-nav" aria-label="Primary, mobile">
      {
        tabs.map((tab) => (
          <a href={tab.href} aria-current={tab.active ? 'page' : undefined}>
            {tab.short}
          </a>
        ))
      }
    </nav>

    <script is:inline>
      (function () {
        var label = document.getElementById('theme-label');
        var toggle = document.getElementById('theme-toggle');

        function current() {
          return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
        }

        function other(theme) {
          return theme === 'dark' ? 'light' : 'dark';
        }

        function setTheme(next) {
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          label.textContent = other(next);
        }

        label.textContent = other(current());
        toggle.addEventListener('click', function () {
          setTheme(other(current()));
        });

        // Single-key shortcuts, matching the hints in the tab line. They can be
        // turned off (WCAG 2.1.4), and the choice is remembered.
        var keysToggle = document.getElementById('keys-toggle');
        var keysLabel = document.getElementById('keys-label');
        var keysOn = true;
        try {
          keysOn = localStorage.getItem('shortcuts') !== 'off';
        } catch (e) {}

        function renderKeys() {
          keysToggle.setAttribute('aria-pressed', String(keysOn));
          keysLabel.textContent = keysOn ? 'Turn off' : 'Turn on';
          toggle.setAttribute('aria-keyshortcuts', keysOn ? 't' : '');
        }

        renderKeys();
        keysToggle.addEventListener('click', function () {
          keysOn = !keysOn;
          try {
            localStorage.setItem('shortcuts', keysOn ? 'on' : 'off');
          } catch (e) {}
          renderKeys();
        });

        var routes = { '1': '/', '2': '/projects', '3': '/stack', '4': '/contact' };
        document.addEventListener('keydown', function (e) {
          if (!keysOn || e.ctrlKey || e.metaKey || e.altKey || e.defaultPrevented) return;
          var t = e.target;
          if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
          if (routes[e.key]) {
            window.location.href = routes[e.key];
          } else if (e.key === 't') {
            setTheme(other(current()));
          }
        });
      })();
    </script>
  </body>
</html>
