---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

import '../styles/global.css';

const {
  title,
  description = 'AI and backend engineer building software for African businesses · Python, FastAPI, PostgreSQL · Co-founder, KekeVest',
  ogImage,
} = Astro.props;

// Crawlers ignore relative og:image URLs, so resolve against the site.
// NOTE: `site` in astro.config.mjs must be the real deployed domain
// for link previews to render.
const ogImageUrl = ogImage ?? (Astro.site ? new URL('og-image.png', Astro.site).href : undefined);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { label: 'Work', href: '/projects', active: path.startsWith('/projects') },
  { label: 'About', href: '/#about', active: false },
  { label: 'Stack', href: '/stack', active: path === '/stack' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F2A33A" />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Augustine Chukwu" />
    {Astro.url && <meta property="og:url" content={Astro.url.href} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="top">
      <header class="site-header container">
        <a class="wordmark hit" href="/">Augustine Chukwu</a>
        <nav class="nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.active ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a class="nav-cta" href="/contact" aria-current={path === '/contact' ? 'page' : undefined}>Say hello</a>
        </nav>
      </header>
      <div id="main" tabindex="-1">
        <slot name="masthead" />
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer" id="contact">
      <div class="site-footer-inner container">
        <div>
          <p class="footer-title">Let's talk.</p>
          <p class="footer-note">Open to remote backend and AI roles, and conversations about KekeVest.</p>
        </div>
        <ul class="footer-links">
          <li><a class="hit" href="mailto:chukwuaugust0@gmail.com">Email</a></li>
          <li><a class="hit" href="https://www.linkedin.com/in/augustine-chukwu-/" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a class="hit" href="https://github.com/Austin-Deccentric" rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
